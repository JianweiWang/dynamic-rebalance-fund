# Staging Environment Configuration for Fund Rebalance Application

# ECS Server Configuration
ECS_HOST=staging-ecs-server.aliyun.com
ECS_USER=ubuntu
ECS_SSH_KEY=~/.ssh/staging_key

# Application Configuration  
APP_PORT=8080
APP_ENV=staging
DOCKER_COMPOSE_FILE=docker-compose.staging.yml

# Docker Registry Configuration
REGISTRY=registry.aliyuncs.com/your-namespace
IMAGE_TAG=staging

# Database Configuration (SQLite - stored in data volume)
DB_PATH=/app/data/fund_data_staging.db

# Security Configuration
ALLOWED_ORIGINS=https://staging.your-domain.com
CORS_ENABLED=true

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE=/app/logs/application.log

# Nginx Configuration
NGINX_WORKER_PROCESSES=1
NGINX_WORKER_CONNECTIONS=512
NGINX_CLIENT_MAX_BODY_SIZE=5m

# Health Check Configuration
HEALTH_CHECK_INTERVAL=15s
HEALTH_CHECK_TIMEOUT=5s
HEALTH_CHECK_RETRIES=5

# Backup Configuration
BACKUP_RETENTION_DAYS=3
BACKUP_SCHEDULE="0 4 * * *"  # Daily at 4 AM