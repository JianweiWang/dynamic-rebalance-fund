# Production Environment Configuration for Fund Rebalance Application

# ECS Server Configuration
ECS_HOST=your-ecs-server.aliyun.com
ECS_USER=root
ECS_SSH_KEY=~/.ssh/id_rsa

# Application Configuration  
APP_PORT=80
APP_ENV=production
DOCKER_COMPOSE_FILE=docker-compose.prod.yml

# Docker Registry Configuration
REGISTRY=registry.aliyuncs.com/your-namespace
IMAGE_TAG=latest

# Database Configuration (SQLite - stored in data volume)
DB_PATH=/app/data/fund_data.db

# Security Configuration
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ENABLED=true

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=/app/logs/application.log

# Nginx Configuration
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_CLIENT_MAX_BODY_SIZE=10m

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=3s
HEALTH_CHECK_RETRIES=3

# Backup Configuration
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM